{
  "name": "@ckadinti/runtime-host",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "pnpm --filter @ckadinti/contracts build && pnpm build && node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:postgres": "vitest run src/persistence.postgres.test.ts"
  },
  "dependencies": {
    "@ckadinti/contracts": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@types/pg": "^8.23.1",
    "fastify": "^5.2.1",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-orm": "^0.43.1",
    "postgres": "^3.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
