{
  "name": "@ckadinti/database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm build && node dist/migrate.js"
  },
  "dependencies": { "dotenv": "^16.4.7", "drizzle-orm": "^0.43.1", "postgres": "^3.4.7" },
  "devDependencies": { "drizzle-kit": "^0.31.10", "typescript": "^5.8.3", "vitest": "^3.1.2" }
}
