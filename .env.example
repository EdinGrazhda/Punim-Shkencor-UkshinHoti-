# Local development: copy this file to .env before starting the app.
# The password in DATABASE_URL must match POSTGRES_PASSWORD. Docker Compose
# exposes PostgreSQL only on this computer for the desktop app.
# Change both values together before using this setup beyond local development.
POSTGRES_PASSWORD=ckadinti-local-dev
DATABASE_URL=postgresql://ckadinti:ckadinti-local-dev@127.0.0.1:5432/ckadinti

# Runtime host (optional for direct pnpm development; Compose sets these itself).
PORT=4310
# For classroom LAN use the teacher computer's reachable IP, for example
# STUDENT_ORIGIN=http://192.168.1.101:4173; restart Compose services afterward.
STUDENT_ORIGIN=http://localhost:4173

# Keyless AI trial for non-confidential lessons. Free model availability varies.
# To use your own provider, set AI_PROVIDER=gemini or openai and add its key.
AI_PROVIDER=kilo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Free providers may log prompts and responses.
KILO_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# PDF OCR runs locally; English is bundled and needs no download or API key.
PDF_OCR_LANGUAGES=eng
# For other scan languages, place every selected .traineddata.gz in this folder.
# Example: PDF_OCR_LANGUAGES=eng+sqi with eng.traineddata.gz and sqi.traineddata.gz.
PDF_OCR_DATA_PATH=
# Optional: OCR even pages with embedded text and no images (bad text layers).
PDF_OCR_FORCE=false
