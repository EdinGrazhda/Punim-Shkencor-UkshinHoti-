# PostgreSQL connection used by the trusted Electron main process.
DATABASE_URL=postgresql://localhost:5432/ckadinti

# Required only for `docker compose up`; choose a local-only password.
POSTGRES_PASSWORD=replace-with-a-local-password

# Runtime host (optional for direct pnpm development; Compose sets these itself).
PORT=4310
STUDENT_ORIGIN=http://localhost:4173

# AI provider used only by the trusted desktop main process for quiz generation.
# Gemini is selected automatically when GEMINI_API_KEY is configured; set AI_PROVIDER to override.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional OpenAI alternative: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Free anonymous test provider: AI_PROVIDER=kilo (no API key required).
# Use non-confidential lessons: free providers may log prompts and responses.
KILO_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# PDF OCR runs locally; English is bundled and needs no download or API key.
PDF_OCR_LANGUAGES=eng
# For other scan languages, place every selected .traineddata.gz in this folder.
# Example: PDF_OCR_LANGUAGES=eng+sqi with eng.traineddata.gz and sqi.traineddata.gz.
PDF_OCR_DATA_PATH=
# Optional: OCR even pages with embedded text and no images (bad text layers).
PDF_OCR_FORCE=false
