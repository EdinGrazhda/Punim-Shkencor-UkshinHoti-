[Unit]
Description=Keep CkaDinTi Graphify knowledge graph current
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/edin/Desktop/Projects/CkaDinTi?
Environment=PATH=/home/edin/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m graphify.watch .
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
